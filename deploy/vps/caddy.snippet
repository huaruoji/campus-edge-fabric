# Append to /etc/caddy/Caddyfile on the DMIT box.
#   443 is owned by xray (Reality) and falls back to caddy on 127.0.0.1:8443,
#   so browsers reach this site at https://cef.huaruoji.com with no port number.
#   bind 127.0.0.1 is NOT optional: without it caddy re-binds *:8443 and publicly
#   exposes the other sites on this box (including the 3x-ui panel proxy).
https://cef.huaruoji.com:8443 {
    bind 127.0.0.1
    encode zstd gzip
    tls /etc/caddy/cert/huaruoji.pem /etc/caddy/cert/huaruoji.key
    reverse_proxy 127.0.0.1:8090 {
        transport http {
            read_timeout 600s
            write_timeout 600s
        }
    }
}
