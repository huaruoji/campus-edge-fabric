[Unit]
Description=Campus Edge Fabric coordinator (API + dashboard + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/campus-edge-fabric
Environment=CEF_DATA=/var/lib/cef
Environment=PYTHONUNBUFFERED=1
# Call the venv entrypoint directly: no uv, no network, no $HOME at runtime.
# (ProtectHome=true hides /root, so anything installed there is invisible to us.)
ExecStart=/opt/campus-edge-fabric/.venv/bin/cef-coord serve --host 127.0.0.1 --port 8090 --data /var/lib/cef --token-file /etc/cef/token
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cef
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
